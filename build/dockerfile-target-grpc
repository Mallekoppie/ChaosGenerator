# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o target-grpc ./cmd/target-grpc

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/target-grpc .

# Expose ports
EXPOSE 9000 9090

# Environment variables with defaults
ENV CHAOS_TARGET_PORT=9000
ENV CHAOS_TARGET_METRICS_PORT=9090

# Run the application
CMD ["./target-grpc"]
