# Build stage
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o target-http ./cmd/target-http

# Runtime stage
# distroless: static binary plus a CA bundle and the "nonroot" user (uid 65532).
# No shell, so Kubernetes probes must use httpGet/tcpSocket (the service exposes
# /health on its own port).
FROM gcr.io/distroless/static-debian13:nonroot

# Copy the binary from builder
COPY --from=builder /app/target-http /target-http

# Expose ports
EXPOSE 8080 9090

# Environment variables with defaults
ENV CHAOS_TARGET_PROTOCOL=http1
ENV CHAOS_TARGET_PORT=8080
ENV CHAOS_TARGET_METRICS_PORT=9090

# Run the application
CMD ["/target-http"]
