# Build stage
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o chaos-agent ./cmd/agent

# --- Runtime stage -----------------------------------------------------------
# distroless: only the static binary and its runtime dependencies (a CA bundle
# at /etc/ssl/certs, /tmp, /etc/passwd) plus the "nonroot" user (uid 65532).
# There is no shell, so Kubernetes probes must use httpGet/tcpSocket - the agent
# exposes /health on its metrics port for exactly that.
FROM gcr.io/distroless/static-debian13:nonroot

# Copy the binary from builder
COPY --from=builder /app/chaos-agent /chaos-agent

# Expose metrics port
EXPOSE 9091

# Environment variables with defaults
ENV CHAOS_MASTER_ADDRESS=chaos-master:9002
ENV CHAOS_AGENT_PORT=8081
ENV CHAOS_AGENT_METRICS_PORT=9091
ENV CHAOS_AGENT_VERSION=1.0.0

# Run the application
CMD ["/chaos-agent"]
