# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o chaos-master ./cmd/master

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/chaos-master .

# Create directory for database
RUN mkdir -p /data

# Expose gRPC port
EXPOSE 9002

# Environment variables with defaults
ENV CHAOS_MASTER_PORT=9002
ENV CHAOS_MASTER_DB_PATH=/data/chaos-master.db

# Volume for persistent data
VOLUME ["/data"]

# Run the application
CMD ["./chaos-master"]
